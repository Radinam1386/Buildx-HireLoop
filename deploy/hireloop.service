[Unit]
Description=HireLoop FastAPI
After=network-online.target
Wants=network-online.target

[Service]
User=hireloop
Group=hireloop
WorkingDirectory=/var/www/hireloop/current/backend
EnvironmentFile=/etc/hireloop/hireloop.env
ExecStart=/var/www/hireloop/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hireloop

[Install]
WantedBy=multi-user.target
