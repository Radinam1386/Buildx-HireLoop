# Copy to .env. Never commit the real key.
HORMOUZ_API_KEY=
# Exact OpenAI-compatible base URL from your Hormouz dashboard, normally ending /v1.
HORMOUZ_BASE_URL=
HORMOUZ_MODEL=gpt-6-luna
MAX_AI_CALLS_PER_DAY=40
MAX_AI_OUTPUT_TOKENS=1200
AI_TIMEOUT_SECONDS=60
# true when deployed behind HTTPS; false only for local HTTP testing.
COOKIE_SECURE=false
DATABASE_PATH=data/hireloop.db
