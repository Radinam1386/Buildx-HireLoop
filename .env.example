# ===== HireLoop — تنظیمات =====
# این فایل را کپی کنید به .env و مقادیر را پر کنید.

# --- ارائه‌دهندهٔ LLM (هرموز یا هر API سازگار با OpenAI) ---
LLM_BASE_URL=https://REPLACE_WITH_HORMOUZ_BASE_URL/v1
LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY

# --- مدل هر ایجنت (نام دقیق مدل را از پنل هرموز بردارید) ---
MODEL_INTERVIEWER=REPLACE_MODEL_NAME_LUNA
MODEL_MATCHER=REPLACE_MODEL_NAME_GLM
MODEL_WRITER=REPLACE_MODEL_NAME_GLM
MODEL_REFINER=REPLACE_MODEL_NAME_LUNA
# مدل سبک برای کارهای کمکی (خلاصهٔ انگلیسی پروفایل، تحلیل آگهی چسبانده‌شده)
MODEL_UTILITY=REPLACE_MODEL_NAME_LUNA

# --- Embedding ---
EMBEDDING_MODEL=REPLACE_EMBEDDING_MODEL_NAME

# --- اختیاری ---
# سطح استدلال (اگر مدل پشتیبانی نکرد خالی بگذارید): low | medium | high
REASONING_EFFORT=
# اگر Provider از response_format=json_object پشتیبانی نمی‌کند false کنید
JSON_MODE=true
# تعداد کاندید بعد از embedding که به LLM داده می‌شود
MATCH_TOP_K=8

# --- امنیت و دیتابیس ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_HOURS=72
DATABASE_URL=sqlite:///./hireloop.db
CORS_ORIGINS=http://localhost:5173
